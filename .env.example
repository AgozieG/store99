# Frontend variables (VITE_* values are safe to expose in the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key
VITE_WHATSAPP_NUMBER=2340000000000
VITE_OWNER_EMAIL=owner@example.com
VITE_API_URL=https://your-backend-domain.com

# Backend secrets (keep these private and configure them in the deployment secret manager)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
WHATSAPP_NUMBER=2340000000000
GMAIL_USER=owner@example.com
GMAIL_APP_PASSWORD=your-gmail-app-password
GMAIL_ORDER_RECIPIENT=owner@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
